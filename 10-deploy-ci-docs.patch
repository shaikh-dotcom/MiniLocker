diff --git a/deploy/bootstrap.sh b/deploy/bootstrap.sh
new file mode 100755
index 0000000000000000000000000000000000000000..16f4febbbf038dbfb4c31027a0ba84e52e9edd80
--- /dev/null
+++ b/deploy/bootstrap.sh
@@ -0,0 +1,182 @@
+#!/usr/bin/env bash
+# Provision MiniLocker on a fresh Ubuntu 22.04/24.04 VM (or any Linux with Docker).
+#
+#   git clone <repo> && cd <repo>
+#   sudo ./deploy/bootstrap.sh              # installs Docker if needed, builds, starts, smoke-tests
+#   ./deploy/bootstrap.sh --env-only        # just create/complete deploy/.env, touch nothing else
+#   ./deploy/bootstrap.sh --skip-smoke      # do not run the post-start containment smoke test
+#
+# Idempotent: safe to re-run after editing deploy/.env or pulling new code.
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+DEPLOY="$ROOT/deploy"
+ENV_FILE="${MINILOCKER_BOOTSTRAP_ENV_FILE:-$DEPLOY/.env}"
+COMPOSE=(docker compose -f "$DEPLOY/docker-compose.yml")
+
+ENV_ONLY=0
+SKIP_SMOKE=0
+for arg in "$@"; do
+  case "$arg" in
+    --env-only) ENV_ONLY=1 ;;
+    --skip-smoke) SKIP_SMOKE=1 ;;
+    -h|--help) sed -n '2,10p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
+    *) echo "unknown option: $arg" >&2; exit 2 ;;
+  esac
+done
+
+log() { printf '\n==> %s\n' "$*"; }
+die() { printf 'error: %s\n' "$*" >&2; exit 1; }
+
+# env_get KEY: the value in $ENV_FILE (last one wins; Windows line endings and quotes stripped).
+env_get() {
+  [ -f "$ENV_FILE" ] || return 0
+  { grep -E "^${1}=" "$ENV_FILE" || true; } | tail -n1 | cut -d= -f2- | tr -d '\r' \
+    | sed -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/"
+}
+
+# env_set KEY VALUE: replace the line, or append it. Only for generated values (hex): no backslashes.
+env_set() {
+  local tmp
+  tmp="$(mktemp)"
+  awk -v k="$1" -v v="$2" 'BEGIN { FS = OFS = "=" } $1 == k { $0 = k "=" v; done = 1 } { print } END { if (!done) print k "=" v }' \
+    "$ENV_FILE" > "$tmp"
+  cat "$tmp" > "$ENV_FILE"      # keep the file's owner and mode
+  rm -f "$tmp"
+}
+
+# A hand-appended `echo KEY=value >> .env` onto a file with no trailing newline glues two settings
+# together (LLM_API_KEY=sk-...HTTP_PORT=8080) and nothing complains. Name the line, never the value.
+check_env_sanity() {
+  local n key bad=0
+  while IFS=: read -r n _; do
+    [ -n "$n" ] || continue
+    key="$(sed -n "${n}p" "$ENV_FILE" | cut -d= -f1)"
+    printf 'error: line %s of %s (%s=...) has another setting glued onto the end of its value.\n' "$n" "$ENV_FILE" "$key" >&2
+    bad=1
+  done < <({ grep -nE '^[A-Za-z_][A-Za-z0-9_]*=.*(LLM_[A-Z_]+|MINILOCKER_[A-Z0-9_]+|SITE_ADDRESS|HTTPS?_PORT)=' "$ENV_FILE" || true; })
+  if [ "$bad" -eq 1 ]; then
+    printf '%s\n' "Put each setting on its own line and trim that value. (Append safely with: printf '\\nKEY=value\\n' >> deploy/.env)" >&2
+    return 2
+  fi
+}
+
+prepare_env() {
+  if [ ! -f "$ENV_FILE" ]; then
+    cp "$DEPLOY/env.production.example" "$ENV_FILE"
+    log "created $ENV_FILE from env.production.example"
+  fi
+  chmod 600 "$ENV_FILE"
+  check_env_sanity || return $?
+
+  if [ -z "$(env_get MINILOCKER_API_TOKEN)" ]; then
+    env_set MINILOCKER_API_TOKEN "$(openssl rand -hex 24)"
+    log "generated MINILOCKER_API_TOKEN"
+  fi
+  local secret
+  secret="$(env_get MINILOCKER_S3_SECRET_KEY)"
+  if [ -z "$secret" ] || [ "$secret" = "minilocker-dev-secret-change-me" ]; then
+    env_set MINILOCKER_S3_SECRET_KEY "$(openssl rand -hex 24)"
+    log "generated MINILOCKER_S3_SECRET_KEY"
+  fi
+  if [ -z "$(env_get MINILOCKER_S3_ACCESS_KEY)" ]; then
+    env_set MINILOCKER_S3_ACCESS_KEY minilocker
+  fi
+
+  local missing=() v
+  for v in LLM_BASE_URL LLM_MODEL LLM_API_KEY; do
+    [ -n "$(env_get "$v")" ] || missing+=("$v")
+  done
+  if [ "${#missing[@]}" -gt 0 ]; then
+    printf '\n%s\n' "Fill in these settings in $ENV_FILE, then run this script again:" >&2
+    printf '  %s\n' "${missing[@]}" >&2
+    return 2
+  fi
+}
+
+install_docker() {
+  if command -v docker >/dev/null 2>&1; then
+    log "Docker present: $(docker --version)"
+  else
+    [ "$(id -u)" -eq 0 ] || die "Docker is not installed; run this script with sudo to install it"
+    log "installing Docker (get.docker.com)"
+    curl -fsSL https://get.docker.com | sh
+  fi
+  docker compose version >/dev/null 2>&1 || die "the 'docker compose' plugin is missing (apt-get install docker-compose-plugin)"
+  docker info >/dev/null 2>&1 || die "cannot reach the Docker daemon (is it running? are you in the docker group, or using sudo?)"
+}
+
+build_images() {
+  log "building the browser sandbox image (first build takes several minutes)"
+  docker build -f "$ROOT/images/browser/Dockerfile" \
+    -t "$(env_get MINILOCKER_BROWSER_IMAGE | grep . || echo minilocker-browser:latest)" "$ROOT"
+  log "pulling the code-sandbox base image"
+  docker pull python:3.12-slim
+  log "building the API and web images"
+  "${COMPOSE[@]}" build
+}
+
+wait_for_api() {
+  log "waiting for the API to become healthy"
+  local _
+  for _ in $(seq 1 60); do
+    if "${COMPOSE[@]}" exec -T api python -c \
+      "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)" >/dev/null 2>&1; then
+      return 0
+    fi
+    sleep 2
+  done
+  "${COMPOSE[@]}" logs --tail 40 api >&2 || true
+  die "the API did not become healthy within 2 minutes (logs above)"
+}
+
+# Runs the rm -rf / attack through the real stack: Docker via the socket proxy, the packaged egress proxy,
+# exec streaming, the ledger volume. No model is involved, so it works before the LLM key is proven.
+smoke_test() {
+  log "smoke test: rm -rf / through the real stack"
+  local out verdict
+  out="$("${COMPOSE[@]}" exec -T api python - < "$DEPLOY/smoke_check.py")" || out="request failed"
+  verdict="$(printf '%s\n' "$out" | head -n1)"
+  if [ "$verdict" != "contained" ]; then
+    "${COMPOSE[@]}" logs --tail 60 api docker-proxy >&2 || true
+    die "smoke test verdict was '$verdict', expected 'contained' (logs above)"
+  fi
+  echo "verdict:         contained"
+  printf '%s\n' "$out" | tail -n +2
+  if printf '%s' "$out" | grep -qE 'NOT |MISSING'; then
+    printf '\nwarning: something above is not available; the stack runs, but some features will not work.\n' >&2
+  fi
+}
+
+main() {
+  prepare_env || exit $?
+  [ "$ENV_ONLY" -eq 0 ] || { log "env ready: $ENV_FILE"; exit 0; }
+
+  install_docker
+  build_images
+  log "starting the stack"
+  "${COMPOSE[@]}" up -d
+  wait_for_api
+  [ "$SKIP_SMOKE" -eq 1 ] || smoke_test
+
+  local site url ip port
+  site="$(env_get SITE_ADDRESS)"
+  site="${site:-:80}"
+  port="$(env_get HTTP_PORT)"
+  ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
+  case "$site" in
+    :*) url="http://${ip:-localhost}$([ "${port:-80}" = 80 ] || printf ':%s' "$port")" ;;
+    *)  url="https://${site}" ;;
+  esac
+  cat <<DONE
+
+MiniLocker is up.
+  URL:        ${url}
+  API token:  $(env_get MINILOCKER_API_TOKEN)      (paste it into the UI's "API token" box)
+
+  logs:       docker compose -f deploy/docker-compose.yml logs -f api
+  stop:       docker compose -f deploy/docker-compose.yml down        (add -v to also delete the data)
+DONE
+}
+
+main
diff --git a/deploy/dev-storage.sh b/deploy/dev-storage.sh
new file mode 100755
index 0000000000000000000000000000000000000000..ff8291f7f91b9712feb883ae34d38530881a62fa
--- /dev/null
+++ b/deploy/dev-storage.sh
@@ -0,0 +1,43 @@
+#!/usr/bin/env bash
+# Local S3-compatible object store for the artifact store (development only).
+#
+# The MinIO community Docker images are no longer published, so this uses RustFS. The code only
+# speaks the S3 API, so any S3 endpoint works instead (Garage, SeaweedFS, Vultr Object Storage...):
+# change the MINILOCKER_S3_* variables, nothing else.
+#
+#   ./deploy/dev-storage.sh          start (or restart) and print the env vars to export
+#   ./deploy/dev-storage.sh stop     stop and remove the container (data volume is kept)
+set -euo pipefail
+
+NAME=minilocker-storage
+IMAGE="${MINILOCKER_STORAGE_IMAGE:-rustfs/rustfs:latest}"   # pin a tag once you have a good one
+PORT="${MINILOCKER_STORAGE_PORT:-9000}"
+ACCESS="${MINILOCKER_S3_ACCESS_KEY:-minilocker-dev}"
+SECRET="${MINILOCKER_S3_SECRET_KEY:-minilocker-dev-secret-change-me}"
+
+if [ "${1:-}" = "stop" ]; then docker rm -f "$NAME" >/dev/null 2>&1 && echo "stopped $NAME"; exit 0; fi
+
+docker rm -f "$NAME" >/dev/null 2>&1 || true
+# Bound to 127.0.0.1: reachable by the control plane on this machine, not from the network.
+# It is NOT on the sandboxes' network, so no sandbox can reach it.
+docker run -d --name "$NAME" --restart unless-stopped \
+  -p "127.0.0.1:${PORT}:9000" \
+  -v minilocker-storage:/data \
+  -e RUSTFS_ACCESS_KEY="$ACCESS" -e RUSTFS_SECRET_KEY="$SECRET" \
+  "$IMAGE" /data >/dev/null
+
+echo "waiting for the S3 endpoint on 127.0.0.1:${PORT} ..."
+for _ in $(seq 1 30); do
+  if curl -s -o /dev/null "http://127.0.0.1:${PORT}/"; then ready=1; break; fi
+  sleep 1
+done
+[ "${ready:-}" = 1 ] || { echo "storage did not come up; see: docker logs $NAME" >&2; exit 1; }
+
+cat <<ENV
+
+Ready. Export these in the shell that runs the API (the bucket is created automatically):
+
+export MINILOCKER_S3_ENDPOINT=http://127.0.0.1:${PORT}
+export MINILOCKER_S3_ACCESS_KEY=${ACCESS}
+export MINILOCKER_S3_SECRET_KEY=${SECRET}
+ENV
diff --git a/deploy/docker-compose.yml b/deploy/docker-compose.yml
new file mode 100644
index 0000000000000000000000000000000000000000..b8d5077d7140cd58909b7c37bb83090f587e4491
--- /dev/null
+++ b/deploy/docker-compose.yml
@@ -0,0 +1,137 @@
+# MiniLocker, production-style stack.   docker compose -f deploy/docker-compose.yml up -d
+# Settings come from deploy/.env (see env.production.example); ./deploy/bootstrap.sh prepares it.
+#
+#   internet -> web (Caddy) -> api -> docker-proxy -> host Docker      api -> storage (S3)
+#
+# The API never touches the raw Docker socket: it talks to a proxy that allows only the API families it
+# needs. Sandboxes and the egress proxy are created by the API as siblings; they are not part of this file.
+name: minilocker
+
+services:
+  docker-proxy:
+    image: ${SOCKET_PROXY_IMAGE:-tecnativa/docker-socket-proxy:latest}
+    restart: unless-stopped
+    environment:
+      # allowed: what minilocker/sandbox, /egress and /attacks actually call
+      CONTAINERS: "1"
+      NETWORKS: "1"
+      IMAGES: "1"
+      EXEC: "1"
+      POST: "1"
+      VERSION: "1"
+      PING: "1"
+      # denied (the proxy's default, spelled out so a reader does not have to look it up)
+      BUILD: "0"
+      VOLUMES: "0"
+      SYSTEM: "0"
+      INFO: "0"
+      EVENTS: "0"
+      SECRETS: "0"
+      SERVICES: "0"
+      SWARM: "0"
+      NODES: "0"
+      TASKS: "0"
+      CONFIGS: "0"
+      PLUGINS: "0"
+      AUTH: "0"
+      COMMIT: "0"
+      DISTRIBUTION: "0"
+      SESSION: "0"
+      GRPC: "0"
+    volumes:
+      - /var/run/docker.sock:/var/run/docker.sock:ro
+    networks: [control]
+    security_opt: ["no-new-privileges:true"]
+    mem_limit: 128m
+
+  storage:
+    image: ${STORAGE_IMAGE:-rustfs/rustfs:latest}
+    restart: unless-stopped
+    command: ["/data"]
+    environment:
+      RUSTFS_ACCESS_KEY: ${MINILOCKER_S3_ACCESS_KEY:?set MINILOCKER_S3_ACCESS_KEY in deploy/.env}
+      RUSTFS_SECRET_KEY: ${MINILOCKER_S3_SECRET_KEY:?set MINILOCKER_S3_SECRET_KEY in deploy/.env}
+    volumes:
+      - storage:/data
+    networks: [data]
+
+  api:
+    build:
+      context: ..
+      dockerfile: deploy/Dockerfile.api
+    image: minilocker-api:latest
+    restart: unless-stopped
+    depends_on: [docker-proxy, storage]
+    # The credential broker's settings (MINILOCKER_BROKER and one MINILOCKER_BROKER_TOKEN_<NAME> per service) have names that
+    # depend on the services you configure, so they are read from deploy/.env directly. `environment:` below wins on a clash.
+    env_file:
+      - path: .env
+        required: false
+    environment:
+      DOCKER_HOST: tcp://docker-proxy:2375
+      MINILOCKER_PROXY_IMAGE: minilocker-api:latest
+      MINILOCKER_BROWSER_IMAGE: ${MINILOCKER_BROWSER_IMAGE:-minilocker-browser:latest}
+      MINILOCKER_API_TOKEN: ${MINILOCKER_API_TOKEN:?set MINILOCKER_API_TOKEN in deploy/.env}
+      LLM_BASE_URL: ${LLM_BASE_URL:?set LLM_BASE_URL in deploy/.env}
+      LLM_MODEL: ${LLM_MODEL:?set LLM_MODEL in deploy/.env}
+      LLM_API_KEY: ${LLM_API_KEY:?set LLM_API_KEY in deploy/.env}
+      LLM_TOOL_MODE: ${LLM_TOOL_MODE:-native}
+      MINILOCKER_PROFILE: ${MINILOCKER_PROFILE:-strict}
+      MINILOCKER_ALLOW: ${MINILOCKER_ALLOW:-pypi.org,files.pythonhosted.org}
+      MINILOCKER_MAX_TASKS: ${MINILOCKER_MAX_TASKS:-2}
+      MINILOCKER_APPROVAL_TIMEOUT: ${MINILOCKER_APPROVAL_TIMEOUT:-60}
+      MINILOCKER_S3_ENDPOINT: http://storage:9000
+      MINILOCKER_S3_ACCESS_KEY: ${MINILOCKER_S3_ACCESS_KEY:?set MINILOCKER_S3_ACCESS_KEY in deploy/.env}
+      MINILOCKER_S3_SECRET_KEY: ${MINILOCKER_S3_SECRET_KEY:?set MINILOCKER_S3_SECRET_KEY in deploy/.env}
+    volumes:
+      - runs:/app/runs
+    read_only: true
+    tmpfs: [/tmp]
+    cap_drop: [ALL]
+    security_opt: ["no-new-privileges:true"]
+    mem_limit: 1g
+    pids_limit: 256
+    networks: [control, data, edge]      # edge gives outbound internet (the model API); control and data do not
+    healthcheck:
+      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"]
+      interval: 15s
+      timeout: 5s
+      retries: 5
+      start_period: 20s
+
+  web:
+    build:
+      context: ..
+      dockerfile: deploy/Dockerfile.web
+    image: minilocker-web:latest
+    restart: unless-stopped
+    depends_on: [api]
+    ports:
+      - "${HTTP_PORT:-80}:80"
+      - "${HTTPS_PORT:-443}:443"
+      - "${HTTPS_PORT:-443}:443/udp"
+    environment:
+      SITE_ADDRESS: ${SITE_ADDRESS:-:80}
+    volumes:
+      - caddy_data:/data
+      - caddy_config:/config
+    read_only: true
+    tmpfs: [/tmp]
+    cap_drop: [ALL]
+    cap_add: [NET_BIND_SERVICE]
+    security_opt: ["no-new-privileges:true"]
+    mem_limit: 256m
+    networks: [edge]
+
+networks:
+  control:
+    internal: true      # api <-> docker-proxy only; no route out
+  data:
+    internal: true      # api <-> storage only; no route out
+  edge: {}              # web <-> api, and the api's route to the model provider
+
+volumes:
+  runs: {}
+  storage: {}
+  caddy_data: {}
+  caddy_config: {}
diff --git a/deploy/dry_run.sh b/deploy/dry_run.sh
new file mode 100755
index 0000000000000000000000000000000000000000..52bebaf5e7defc24f3871c3cc86b75b39a060a69
--- /dev/null
+++ b/deploy/dry_run.sh
@@ -0,0 +1,84 @@
+#!/usr/bin/env bash
+# Rehearse the deployment on a clean machine, twice, and check what a second run must not change.
+#
+#   git clone <repo> && cd <repo>
+#   sudo LLM_BASE_URL=... LLM_MODEL=... LLM_API_KEY=... ./deploy/dry_run.sh
+#
+# Any clean Ubuntu 22.04/24.04 box will do: a throwaway VM, a cloud instance, a fresh WSL distro. It does what the real
+# deployment does (deploy/bootstrap.sh, twice) and then checks the things a deployment gets wrong quietly:
+#   1. the first run finishes, including the containment smoke test;
+#   2. the API is healthy and refuses a request with no token (401) and accepts one with the token;
+#   3. the generated secrets are mode 600 and are the SAME after the second run (a re-run must not rotate the token
+#      the operator already pasted into the UI);
+#   4. the second run finishes too, and nothing is left running that should not be (no sandbox from the smoke test);
+#   5. the UI is served and the Infra endpoint answers.
+# It prints one line per check and exits non-zero on the first failure. It never prints a secret.
+# shellcheck disable=SC2015   # `check && pass || fail`: pass never fails, so this is an if-else
+set -uo pipefail
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+ENV_FILE="${MINILOCKER_BOOTSTRAP_ENV_FILE:-$ROOT/deploy/.env}"
+COMPOSE=(docker compose -f "$ROOT/deploy/docker-compose.yml")
+FAILS=0
+
+pass() { printf '  PASS  %s\n' "$*"; }
+fail() { printf '  FAIL  %s\n' "$*" >&2; FAILS=$((FAILS + 1)); }
+step() { printf '\n== %s\n' "$*"; }
+env_get() { { grep -E "^${1}=" "$ENV_FILE" || true; } | tail -n1 | cut -d= -f2- | tr -d '\r'; }
+sha() { env_get "$1" | sha256sum | cut -c1-16; }
+
+# Seed the three model settings from the environment, so the script can run unattended.
+if [ ! -f "$ENV_FILE" ]; then
+  : "${LLM_BASE_URL:?set LLM_BASE_URL (and LLM_MODEL, LLM_API_KEY) in the environment, or create deploy/.env first}"
+  : "${LLM_MODEL:?set LLM_MODEL}"
+  : "${LLM_API_KEY:?set LLM_API_KEY}"
+  "$ROOT/deploy/bootstrap.sh" --env-only >/dev/null 2>&1 || true      # creates the file and generates the secrets, then stops
+  for kv in LLM_BASE_URL LLM_MODEL LLM_API_KEY; do
+    tmp="$(mktemp)"
+    awk -v k="$kv" -v v="${!kv}" 'BEGIN { FS = OFS = "=" } $1 == k { $0 = k "=" v; done = 1 } { print } END { if (!done) print k "=" v }' \
+      "$ENV_FILE" > "$tmp" && cat "$tmp" > "$ENV_FILE"; rm -f "$tmp"
+  done
+fi
+
+step "run 1: bootstrap"
+if "$ROOT/deploy/bootstrap.sh"; then pass "bootstrap.sh finished (build, start, smoke test)"; else fail "bootstrap.sh run 1 failed"; exit 1; fi
+
+TOKEN="$(env_get MINILOCKER_API_TOKEN)"
+S3="$(env_get MINILOCKER_S3_SECRET_KEY)"
+TOKEN_ID="$(sha MINILOCKER_API_TOKEN)"; S3_ID="$(sha MINILOCKER_S3_SECRET_KEY)"
+PORT="$(env_get HTTP_PORT)"; PORT="${PORT:-80}"
+BASE="http://127.0.0.1:${PORT}"
+[ "$(env_get SITE_ADDRESS)" = "" ] || case "$(env_get SITE_ADDRESS)" in :*) ;; *) BASE="https://$(env_get SITE_ADDRESS)" ;; esac
+
+step "checks after run 1"
+[ -n "$TOKEN" ] && [ "${#TOKEN}" -ge 32 ] && pass "an API token was generated (${#TOKEN} chars)" || fail "no API token, or a short one"
+[ -n "$S3" ] && [ "$S3" != "minilocker-dev-secret-change-me" ] && pass "the storage secret was generated" || fail "the storage secret is empty or the example value"
+mode="$(stat -c %a "$ENV_FILE")"
+[ "$mode" = "600" ] && pass "deploy/.env is mode 600" || fail "deploy/.env is mode $mode, expected 600"
+if git -C "$ROOT" check-ignore -q "$ENV_FILE" 2>/dev/null || ! git -C "$ROOT" rev-parse >/dev/null 2>&1; then pass "deploy/.env is not tracked by git"; else fail "deploy/.env would be committed"; fi
+
+code="$(curl -ks -o /dev/null -w '%{http_code}' "$BASE/api/tasks")"
+[ "$code" = "401" ] && pass "GET /api/tasks without a token is refused (401)" || fail "GET /api/tasks without a token returned $code, expected 401"
+code="$(curl -ks -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $TOKEN" "$BASE/api/tasks")"
+[ "$code" = "200" ] && pass "GET /api/tasks with the token works (200)" || fail "GET /api/tasks with the token returned $code"
+code="$(curl -ks -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $TOKEN" "$BASE/api/infra")"
+[ "$code" = "200" ] && pass "the Infra endpoint answers (200)" || fail "GET /api/infra returned $code"
+curl -ks "$BASE/" | grep -qi '<div id="root"' && pass "the UI is served" || fail "the UI did not come back from $BASE/"
+left="$(docker ps -a --filter label=minilocker=sandbox --format '{{.Names}}' | wc -l)"
+[ "$left" = "0" ] && pass "no sandbox container left over from the smoke test" || fail "$left sandbox container(s) left over"
+
+step "run 2: bootstrap again (must be idempotent)"
+if "$ROOT/deploy/bootstrap.sh"; then pass "bootstrap.sh finished again"; else fail "bootstrap.sh run 2 failed"; fi
+
+step "checks after run 2"
+[ "$(sha MINILOCKER_API_TOKEN)" = "$TOKEN_ID" ] && pass "the API token did not change" || fail "the API token CHANGED on the second run"
+[ "$(sha MINILOCKER_S3_SECRET_KEY)" = "$S3_ID" ] && pass "the storage secret did not change" || fail "the storage secret CHANGED on the second run"
+code="$(curl -ks -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $TOKEN" "$BASE/api/tasks")"
+[ "$code" = "200" ] && pass "the same token still works" || fail "the token no longer works ($code)"
+n="$("${COMPOSE[@]}" ps --status running --format '{{.Service}}' | sort -u | wc -l)"
+[ "$n" -ge 4 ] && pass "$n services running" || fail "only $n services running (expected api, web, storage and the docker proxy)"
+left="$(docker ps -a --filter label=minilocker=sandbox --format '{{.Names}}' | wc -l)"
+[ "$left" = "0" ] && pass "no sandbox left over" || fail "$left sandbox container(s) left over"
+
+step "result"
+if [ "$FAILS" -eq 0 ]; then echo "All checks passed. Write the date, the machine and the commit in the checklist (docs/DEPLOY_DRYRUN.md)."; else echo "$FAILS check(s) failed." >&2; exit 1; fi
diff --git a/deploy/env.production.example b/deploy/env.production.example
new file mode 100644
index 0000000000000000000000000000000000000000..5089302a92c077e4d790192b1e417df3195d3ba1
--- /dev/null
+++ b/deploy/env.production.example
@@ -0,0 +1,47 @@
+# Production settings. One setting per line. To add one by hand: printf '\nKEY=value\n' >> deploy/.env
+# (a bare `echo KEY=value >>` glues it onto the last line when the file has no trailing newline).
+# ./deploy/bootstrap.sh copies this to deploy/.env and fills in the secrets it can
+# generate. docker compose reads deploy/.env automatically. Never commit deploy/.env.
+
+# ---- the model (OpenAI-compatible endpoint) ----
+LLM_BASE_URL=https://api.groq.com/openai/v1
+LLM_MODEL=openai/gpt-oss-120b
+LLM_API_KEY=
+# How the model is asked to call tools: native (the provider's tool calling) or json (the tools are described in
+# the prompt and the model answers with a JSON object; for a model with no, or unreliable, tool calling).
+# Pick with the bake-off: python -m minilocker.llm.bakeoff --models <name> --mode both
+# LLM_TOOL_MODE=native
+
+# ---- access ----
+# :80 serves plain HTTP (by IP, or locally). A domain name turns on automatic HTTPS: its DNS A record
+# must point at this machine and ports 80 and 443 must be reachable.
+SITE_ADDRESS=:80
+# Host ports, if 80/443 are taken (for example when rehearsing on Windows). Inside the container it is always 80/443.
+# HTTP_PORT=8080
+# HTTPS_PORT=8443
+# Required. Everything under /api needs "Authorization: Bearer <token>"; paste it in the UI's API token box.
+MINILOCKER_API_TOKEN=
+
+# ---- policy ----
+MINILOCKER_PROFILE=strict
+# Hosts the sandboxes and the browser may reach. Subdomains are included. Keep it short: every entry is
+# a place a hijacked agent could send data to.
+MINILOCKER_ALLOW=pypi.org,files.pythonhosted.org,wikipedia.org
+MINILOCKER_MAX_TASKS=2
+MINILOCKER_APPROVAL_TIMEOUT=60
+
+# ---- artifact store (the bundled S3-compatible RustFS; reachable only by the API) ----
+MINILOCKER_S3_ACCESS_KEY=minilocker
+MINILOCKER_S3_SECRET_KEY=
+
+# ---- optional: pin images once you have verified a version ----
+# SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:latest
+# STORAGE_IMAGE=rustfs/rustfs:latest
+# MINILOCKER_BROWSER_IMAGE=minilocker-browser:latest
+
+# ---- optional: credential broker ----
+# Lets the agent call an API that needs a token without ever holding it: the sandbox gets a placeholder, and the egress
+# proxy adds the real token to requests it makes itself. Format: name=host[:header],... ; one TOKEN line per service.
+# Give it the narrowest token you can: the agent cannot read it, but it can ask the broker to use it.
+# MINILOCKER_BROKER=github=api.github.com
+# MINILOCKER_BROKER_TOKEN_GITHUB=
diff --git a/deploy/smoke_check.py b/deploy/smoke_check.py
new file mode 100644
index 0000000000000000000000000000000000000000..3b0a29d931116d1dd440bf9e93abe87dd4022d5a
--- /dev/null
+++ b/deploy/smoke_check.py
@@ -0,0 +1,25 @@
+"""Post-start check, run INSIDE the api container by deploy/bootstrap.sh (stdin: `python - < this file`).
+
+Line 1 of the output is the verdict of the rm -rf / attack, run through the real stack with no model.
+The lines after it report the other things a deployment can get wrong without any task failing loudly.
+"""
+import json
+import os
+import urllib.request
+
+BASE = os.environ.get("SMOKE_BASE", "http://127.0.0.1:8000")
+HEADERS = {"Authorization": "Bearer " + os.environ["MINILOCKER_API_TOKEN"]}
+
+
+def call(path, method="GET"):
+    req = urllib.request.Request(BASE + path, method=method, headers=HEADERS)
+    with urllib.request.urlopen(req, timeout=180) as r:
+        return json.load(r)
+
+
+print(call("/api/attacks/rm_rf_root/run", "POST").get("verdict"))
+status = call("/api/status")
+art = status.get("artifacts") or {}
+print("egress proxy:    " + ("running" if status.get("egress") else "NOT running"))
+print("artifact store:  " + ("attached" if art.get("attached") else f"NOT attached ({art.get('error') or 'not configured'})"))
+print("browser image:   " + ("present" if (status.get("browser") or {}).get("image_present") else "MISSING"))
