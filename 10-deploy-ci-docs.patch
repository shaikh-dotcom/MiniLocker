diff --git a/deploy/Caddyfile b/deploy/Caddyfile
new file mode 100644
index 0000000000000000000000000000000000000000..8efae6fb99ed45b65f091a4e7c877ffbb8708730
--- /dev/null
+++ b/deploy/Caddyfile
@@ -0,0 +1,32 @@
+{
+	admin off
+}
+
+# SITE_ADDRESS=:80            plain HTTP (local / by IP)
+# SITE_ADDRESS=example.org    automatic HTTPS (DNS must point here; ports 80 and 443 reachable)
+{$SITE_ADDRESS::80} {
+	encode zstd gzip
+
+	# "?" = only if the upstream did not set it, so the API's own headers (for example the ones that
+	# make agent-produced files download-only) are never overwritten.
+	header {
+		?X-Content-Type-Options nosniff
+		?X-Frame-Options DENY
+		?Referrer-Policy no-referrer
+		?Strict-Transport-Security "max-age=31536000"
+		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
+		-Server
+	}
+
+	handle /api/* {
+		reverse_proxy api:8000 {
+			flush_interval -1   # server-sent events must not be buffered
+		}
+	}
+
+	handle {
+		root * /srv
+		try_files {path} /index.html
+		file_server
+	}
+}
diff --git a/deploy/Dockerfile.api b/deploy/Dockerfile.api
new file mode 100644
index 0000000000000000000000000000000000000000..6b3355991e87ce29e50f779fdcbaedadf230c216
--- /dev/null
+++ b/deploy/Dockerfile.api
@@ -0,0 +1,24 @@
+# The control plane (FastAPI). Also the image the egress proxy runs from (MINILOCKER_PROXY_IMAGE):
+# the proxy is a module of this package, so no file from this container is ever bind-mounted.
+# Build context: the repository root.
+FROM python:3.12-slim-bookworm
+
+ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 HOME=/tmp
+
+RUN useradd --uid 10001 --user-group --no-create-home --shell /usr/sbin/nologin app \
+ && mkdir -p /app/runs && chown app:app /app/runs
+WORKDIR /app
+
+COPY backend/requirements.txt /tmp/requirements.txt
+# runtime dependencies only: the test tools (pytest, moto) stay out of the image
+RUN grep -vE '^(pytest|moto)' /tmp/requirements.txt > /tmp/runtime.txt \
+ && pip install -r /tmp/runtime.txt && rm /tmp/requirements.txt /tmp/runtime.txt
+
+COPY backend/minilocker ./minilocker
+# the egress proxy container runs this code as uid 65534
+RUN chmod -R a+rX /app/minilocker
+
+ENV MINILOCKER_HOST=0.0.0.0 MINILOCKER_LEDGER_DIR=/app/runs
+USER 10001:10001
+EXPOSE 8000
+CMD ["python", "-m", "minilocker.api"]
