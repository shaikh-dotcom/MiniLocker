+def _docker_ready():
+    try:
+        import docker
+        c = docker.from_env()
+        c.ping()
+        c.images.get("python:3.12-slim")
+        return True
+    except Exception:
+        return False
+
+
+needs_docker = pytest.mark.skipif(not _docker_ready(), reason="needs a Docker daemon and the python:3.12-slim image")
