+# ---- 5. memory bomb ---------------------------------------------------------
+MEM_PY = """chunks = []
+mb = 0
+while True:
+    chunks.append(b"x" * (32 * 1024 * 1024))
+    mb += 32
+    print("allocated", mb, "MB", flush=True)
+"""
