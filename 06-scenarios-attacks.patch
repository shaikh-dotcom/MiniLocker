+)
+
+ATTACKS = (DENY_THEN_BYPASS, RM_RF_ROOT, FORK_BOMB, CPU_BURN, MEMORY_BOMB, DISK_FILL,
+           READ_SECRETS, EXFIL, ESCAPE, HOOK, STEAL, REWIND, *BROWSER_ATTACKS)
+BY_NAME = {a.name: a for a in ATTACKS}
+
+
+def get_attack(name):
+    return BY_NAME.get(name)
