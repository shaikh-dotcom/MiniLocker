--- /dev/null
+++ b/frontend/index.html
@@ -0,0 +1,27 @@
+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="UTF-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <meta name="theme-color" content="#f2f0eb" />
+    <title>MiniLocker · Blast Radius</title>
+    <link
+      rel="icon"
+      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32' fill='none'%3E%3Crect width='32' height='32' rx='7' fill='%230a0a0c'/%3E%3Ccircle cx='16' cy='16' r='11' stroke='%23f2f1ed' stroke-width='1.6'/%3E%3Ccircle cx='16' cy='16' r='6.4' stroke='%23f2f1ed' stroke-width='1.8'/%3E%3Ccircle cx='16' cy='16' r='2.6' fill='%23ff2052'/%3E%3C/svg%3E"
+    />
+    <script>
+      // set the theme before first paint so there is no flash
+      try {
+        var t = localStorage.getItem("minilocker.theme");
+        if (t !== "light" && t !== "dark") t = "light";
+        document.documentElement.dataset.theme = t;
+      } catch (e) {
+        document.documentElement.dataset.theme = "light";
+      }
+    </script>
+  </head>
+  <body>
+    <div id="root"></div>
+    <script type="module" src="/src/main.tsx"></script>
+  </body>
+</html>
