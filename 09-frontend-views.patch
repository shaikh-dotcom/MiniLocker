+import { useCallback, useEffect, useState } from "react";
+import { listTasks } from "./api";
+import type { TaskSummary } from "./api";
+import { Btn, Card, Chip, PageHead, Segmented, Spin, Stat } from "./ui";
+import type { Tint } from "./ui";
+
+type Filter = "all" | "task" | "attack";
+
+function badge(t: TaskSummary): { text: string; tone: Tint } {
+  const s = t.status;
+  if (s === "running") return { text: "running", tone: "info" };
+  if (s === "finished") {
+    return t.kind === "task" && t.tool_calls === 0
+      ? { text: "answered · no commands", tone: "mute" }
+      : { text: "finished", tone: "ok" };
+  }
+  if (s.startsWith("halted")) return { text: s, tone: "warn" };
+  if (s.startsWith("error")) return { text: s, tone: "bad" };
+  return { text: s, tone: "mute" };   // incomplete: no task.end was ever written
+}
+
+/** A count that only draws the eye when it is not zero. */
+const pill = (v: number, tone: Tint) => v > 0
+  ? <span className={`inline-flex min-w-[1.7rem] justify-center rounded-full px-1.5 font-bold ${tone === "bad" ? "bg-bad-wash text-bad" : "bg-warn-wash text-warn"}`}>{v}</span>
+  : <span className="text-ink-3">0</span>;
+
+const TH = "px-3 py-2.5 text-left font-normal";
+
+export function SessionsScreen({ onOpen, onReport }: { onOpen: (id: string) => void; onReport: (id: string) => void }) {
+  const [rows, setRows] = useState<TaskSummary[] | null>(null);
+  const [err, setErr] = useState<string | null>(null);
+  const [filter, setFilter] = useState<Filter>("all");
+
+  const load = useCallback(() => {
+    listTasks(100).then(r => { setRows(r.tasks); setErr(null); }).catch(e => setErr((e as Error).message));
+  }, []);
+  useEffect(load, [load]);
+  const anyRunning = rows?.some(r => r.status === "running") ?? false;
+  useEffect(() => {
+    if (!anyRunning) return;
+    const i = setInterval(load, 3000);
+    return () => clearInterval(i);
+  }, [anyRunning, load]);
+
+  const all = rows ?? [];
+  const shown = all.filter(r => filter === "all" || r.kind === filter);
+  const verified = all.filter(r => r.verified).length;
+  const blocked = all.reduce((s, r) => s + r.egress_blocked, 0), denied = all.reduce((s, r) => s + r.denied, 0);
+  const calls = all.reduce((s, r) => s + r.tool_calls, 0);
+  return (
+    <div className="min-h-0 flex-1 overflow-y-auto px-6 py-7">
+      <div className="mx-auto max-w-7xl space-y-5">
+        <PageHead eyebrow="Recorded runs" title="Sessions" sub="Every task and attack the control plane has run, each with a ledger you can replay and verify."
+          right={<>
+            <Segmented<Filter> label="Filter sessions" value={filter} onChange={setFilter}
+              options={[{ id: "all", label: "All" }, { id: "task", label: "Tasks" }, { id: "attack", label: "Attacks" }]} />
+            <Btn size="sm" onClick={load}>↻ Refresh</Btn>
+          </>} />
+        {err && <p role="alert" className="text-[0.92rem] text-bad">{err}</p>}
+        {!rows && !err && <div className="flex items-center justify-center gap-2 py-12 italic text-ink-3"><Spin /> Loading sessions…</div>}
+        {rows && all.length > 0 && (
+          <Card className="rise grid grid-cols-5 gap-x-6 px-6 py-4">
+            <Stat label="Sessions" value={all.length} sub={`${all.filter(r => r.kind === "task").length} tasks · ${all.filter(r => r.kind === "attack").length} attacks`} />
+            <Stat label="Tool calls" value={calls} sub="commands, writes and browses" className="border-l border-rule pl-5" />
+            <Stat label="Requests blocked" value={blocked} tone={blocked ? "bad" : "ok"} sub="by the egress proxy" className="border-l border-rule pl-5" />
+            <Stat label="Commands denied" value={denied} tone={denied ? "bad" : "ok"} sub="by the policy engine" className="border-l border-rule pl-5" />
+            <Stat label="Ledgers intact" value={<>{verified}<span className="text-[1.3rem] text-ink-3">/{all.length}</span></>}
+              tone={verified === all.length ? "ok" : "bad"} sub="hash chain verified" className="border-l border-rule pl-5" />
+          </Card>
+        )}
+        {rows && shown.length === 0 && (
+          <p className="py-10 text-center italic text-ink-2">No sessions yet. Run a task in the Workspace or an attack in the Attack Lab.</p>
+        )}
+        {shown.length > 0 && (
+          <figure className="rise">
+            <Card className="overflow-x-auto">
+              <table className="w-full text-[0.93rem]">
+                <thead className="smcp text-[0.88rem] text-ink-2">
+                  <tr className="border-b border-rule-2 bg-sunken/50">
+                    {["Started", "", "Task", "Status", "Time", "Blocked", "Denied", "Ledger", ""].map((h, i) => (
+                      <th key={i} className={`${TH} ${i >= 4 && i <= 6 ? "!text-right" : ""}`}>{h}</th>))}
+                  </tr>
+                </thead>
+                <tbody>
+                  {shown.map(r => {
+                    const b = badge(r);
+                    return (
+                      <tr key={r.task_id} className="border-b border-rule/70 transition last:border-0 hover:bg-raised">
+                        <td className="whitespace-nowrap px-3 py-2.5 tabular-nums text-ink-2">{r.started ? new Date(r.started * 1000).toLocaleString(undefined, { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" }) : "—"}</td>
+                        <td className="px-3 py-2.5"><Chip tone={r.kind === "attack" ? "warn" : "info"}>{r.kind}</Chip></td>
+                        <td className="max-w-[18rem] truncate px-3 py-2.5 text-ink" title={r.task}>{r.task || <i className="text-ink-3">no task text</i>}</td>
+                        <td className="px-3 py-2.5"><Chip tone={b.tone} dot className="max-w-[11rem]"><span className="truncate" title={b.text}>{b.text}</span></Chip></td>
+                        <td className="px-3 py-2.5 text-right tabular-nums text-ink-2">{r.duration_s !== null ? `${r.duration_s.toFixed(1)}s` : "—"}</td>
+                        <td className="px-3 py-2.5 text-right tabular-nums">{pill(r.egress_blocked, "bad")}</td>
+                        <td className="px-3 py-2.5 text-right tabular-nums">{pill(r.denied, "bad")}</td>
+                        <td className="whitespace-nowrap px-3 py-2.5 tabular-nums">
+                          {r.verified ? <span className="text-ok">✓ <span className="text-ink-2">{r.events}</span></span> : <span className="font-bold text-bad">✗ broken</span>}
+                        </td>
+                        <td className="whitespace-nowrap px-3 py-2.5 text-right">
+                          <Btn size="sm" onClick={() => onOpen(r.task_id)}>Replay</Btn>{" "}
+                          <Btn size="sm" onClick={() => onReport(r.task_id)}>Report</Btn>
+                        </td>
+                      </tr>
+                    );
+                  })}
+                </tbody>
+              </table>
+            </Card>
+            <figcaption className="mt-2.5 text-[0.85rem] italic text-ink-3"><b className="not-italic text-ink-2">Table 1.</b> Recorded sessions. “Ledger” is the hash-chain check, with its event count.</figcaption>
+          </figure>
+        )}
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/Terminal.tsx b/frontend/src/Terminal.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b4c6a34b1e8802165eeb6fd1f47fedb19b952efd
--- /dev/null
+++ b/frontend/src/Terminal.tsx
@@ -0,0 +1,128 @@
+import { useEffect, useRef } from "react";
+import { Terminal as XTerm } from "@xterm/xterm";
+import { FitAddon } from "@xterm/addon-fit";
+import "@xterm/xterm/css/xterm.css";
+import type { LedgerEvent } from "./api";
+import { parseArgs } from "./derive";
+import { Mark } from "./ui";
+
+const R = "\x1b[31m", G = "\x1b[32m", Y = "\x1b[33m", D = "\x1b[2m", X = "\x1b[0m";
+// Sandbox output is untrusted: strip control bytes so it can't inject escape
+// sequences that fake our [policy]/[egress] lines. \n and \t survive.
+const clean = (s: string) => s.replace(/[\x00-\x08\x0b-\x1f\x7f]/g, "");
+
+const FALLBACK_FONT = 'ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';
+const CM_FONT = `"CMU Typewriter Text", ${FALLBACK_FONT}`;
+
+/** The terminal is always a dark "listing", in both themes, so output stays the focal point of the page. */
+const THEME = {
+  background: "#08080b", foreground: "#f2f1ed", cursor: "#ff2052", selectionBackground: "rgba(255, 32, 82, 0.28)",
+  black: "#08080b", red: "#ff5a4f", green: "#5b9dff", yellow: "#f59e0b", blue: "#b39cff", magenta: "#f06cb4", cyan: "#5be3d0", white: "#f2f1ed",
+  brightBlack: "#8e8c86", brightRed: "#ff8a80", brightGreen: "#8fbcff", brightYellow: "#fbbf24", brightBlue: "#cdbfff", brightMagenta: "#f9a8d4", brightCyan: "#99f0e2", brightWhite: "#ffffff",
+};
+
+function render(e: LedgerEvent): string {
+  const p = e.payload;
+  switch (e.type) {
+    case "tool.call": {
+      const a = parseArgs(p.args ?? "");
+      if (p.tool === "run_shell") return `${G}$${X} ${clean(String(a?.cmd ?? p.args))}\n`;
+      if (p.tool === "finish") return "";
+      if (p.tool === "browse")
+        return `${D}# browse ${clean(String(a?.action ?? ""))} ${clean(String(a?.url ?? a?.selector ?? ""))}${X}\n`;
+      return `${D}# ${p.tool} ${clean(String(a?.path ?? ""))}${X}\n`;
+    }
+    case "tool.result": {
+      const m = clean(String(p.result ?? "")).match(/^exit_code=(-?\d+)\n?([\s\S]*)$/);
+      if (!m) return `${clean(String(p.result ?? ""))}\n`;   // e.g. a policy block message
+      const body = m[2].replace(/\n+$/, "");
+      return `${body ? body + "\n" : ""}${m[1] === "0" ? D : R}[exit ${m[1]}]${X}\n`;
+    }
+    case "policy.decision":
+      return p.action === "allow" ? "" : `${p.action === "deny" ? R : Y}[policy:${p.action}] ${clean((p.reasons ?? []).join("; "))}${X}\n`;
+    case "injection.suspected":
+      return `${R}[injection suspected] page ${clean(String(p.seq))} score ${clean(String(p.score))}: ${clean((p.findings ?? []).map((f: any) => String(f.label)).join("; "))}${X}\n`;
+    case "egress.blocked": return `${R}[egress blocked${p.source === "browser" ? ": browser" : ""}] ${clean(String(p.host))} (${clean(String(p.reason ?? ""))})${X}\n`;
+    case "approval.requested": return `${Y}[approval needed] ${clean(String(p.summary))}${X}\n`;
+    case "approval.granted": return `${G}[approved]${X}\n`;
+    case "approval.denied": return `${R}[denied]${X}\n`;
+    case "task.end": return `${D}── task ${clean(String(p.status))} ──${X}\n`;
+    default: return "";
+  }
+}
+
+export function TerminalView({ events }: { events: LedgerEvent[] }) {
+  const el = useRef<HTMLDivElement>(null);
+  const term = useRef<XTerm | null>(null);
+  const done = useRef(0);
+  const seen = useRef(new Map<string, { n: number; label: string }>());   // repeated egress blocks
+
+  useEffect(() => {
+    const t = new XTerm({ fontSize: 14, lineHeight: 1.28, convertEol: true, disableStdin: true, scrollback: 5000,
+      fontFamily: FALLBACK_FONT, theme: THEME });
+    const fit = new FitAddon();
+    t.loadAddon(fit);
+    t.open(el.current!);
+    fit.fit();
+    term.current = t; done.current = 0; seen.current.clear();
+    const ro = new ResizeObserver(() => { try { fit.fit(); } catch { /* hidden tab: zero size */ } });
+    ro.observe(el.current!);
+    // Computer Modern Typewriter loads lazily; switch to it once it is ready so the cell grid is measured with the real glyphs.
+    let alive = true;
+    document.fonts.load('500 14px "CMU Typewriter Text"').then(() => {
+      if (!alive) return;
+      t.options.fontFamily = CM_FONT;
+      try { fit.fit(); } catch { /* hidden tab */ }
+    }).catch(() => { /* keep the fallback face */ });
+    return () => { alive = false; ro.disconnect(); t.dispose(); term.current = null; };
+  }, []);
+
+  useEffect(() => {
+    const t = term.current;
+    if (!t) return;
+    if (events.length < done.current) { t.reset(); done.current = 0; seen.current.clear(); }   // new task
+    // A page that loads 30 images from one blocked host is one red line plus a count, not 30 lines.
+    const flush = () => {
+      for (const v of seen.current.values()) {
+        if (v.n) { t.write(`${D}  … ${v.n} more blocked request(s) → ${v.label}${X}\n`); v.n = 0; }
+      }
+    };
+    for (; done.current < events.length; done.current++) {
+      const ev = events[done.current];
+      if (ev.type === "egress.blocked") {
+        const key = `${ev.payload.source}|${ev.payload.host}|${ev.payload.reason}`;
+        const hit = seen.current.get(key);
+        if (hit) { hit.n++; continue; }
+        seen.current.set(key, { n: 0, label: `${clean(String(ev.payload.host))} (${clean(String(ev.payload.reason ?? ""))})` });
+      } else if (ev.type === "tool.result" || ev.type === "task.end") {
+        flush();
+      }
+      const s = render(ev);
+      if (s) t.write(s);
+    }
+  }, [events]);
+
+  return (
+    <div className="relative flex h-full flex-col bg-term">
+      <div className="flex shrink-0 items-center gap-3 border-b border-white/10 bg-white/[.025] px-3.5 py-2.5 text-term-dim">
+        <span aria-hidden className="flex gap-1.5">
+          <i className="h-2.5 w-2.5 rounded-full bg-bad/80" /><i className="h-2.5 w-2.5 rounded-full bg-warn/80" /><i className="h-2.5 w-2.5 rounded-full bg-ok/80" />
+        </span>
+        <span className="font-mono text-[0.8rem]"><span className="text-ok">●</span> sandbox <span className="text-term-fg/60">·</span> /workspace</span>
+        <span className="ml-auto text-[0.8rem] italic tabular-nums">{events.length} ledger event{events.length === 1 ? "" : "s"}</span>
+      </div>
+      <div ref={el} className="min-h-0 flex-1 px-3 py-2" />
+      {events.length === 0 && (
+        <div className="pointer-events-none absolute inset-0 top-9 grid place-items-center p-8 text-center">
+          <div className="rise max-w-sm text-term-fg">
+            <div className="relative mx-auto mb-4 grid h-24 w-24 place-items-center"><span aria-hidden className="spin-center absolute inset-0 rounded-full border border-dashed border-white/20" style={{ animationDuration: "40s" }} /><Mark size={56} className="text-term-dim" /></div>
+            <div className="display text-[1.5rem]">Nothing has run yet</div>
+            <p className="mt-1 leading-relaxed text-term-dim">
+              Describe a task on the left. The agent works inside a sandbox, and everything it touches is measured and written to the ledger.
+            </p>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/frontend/src/Timeline.tsx b/frontend/src/Timeline.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..21e51b8f2ce6094c535e25827feffe77145532a4
--- /dev/null
+++ b/frontend/src/Timeline.tsx
@@ -0,0 +1,90 @@
+import { useState } from "react";
+import { releaseTask, rewindTask } from "./api";
+import type { LedgerEvent } from "./api";
+import { timeline } from "./derive";
+import type { TimelineNode } from "./derive";
+import { Btn, Chip, Empty, Hash, PageHead } from "./ui";
+
+const CHIP: Record<TimelineNode["kind"], string> = {
+  start: "border-rule-2 text-ink-2",
+  tool: "border-accent/50 text-accent-ink",
+  rewind: "border-info/55 text-info",
+};
+const DOT: Record<TimelineNode["kind"], string> = {
+  start: "border-ink-3 bg-paper",
+  tool: "border-accent bg-accent shadow-[0_0_12px_var(--accent)]",
+  rewind: "border-info bg-info-wash shadow-[0_0_12px_var(--info)]",
+};
+
+function Node({ n, i, canRewind, busy, onRewind }: { n: TimelineNode; i: number; canRewind: boolean; busy: boolean; onRewind: (id: number) => void }) {
+  return (
+    <li className="relative pb-5 pl-9" style={{ animationDelay: `${Math.min(i, 12) * 30}ms` }}>
+      <span aria-hidden className={`absolute left-0 top-[1.15rem] h-[18px] w-[18px] rounded-full border-2 ${n.undone ? "border-ink-3/50 bg-paper" : DOT[n.kind]}`} />
+      <div className={`rise panel p-3.5 ${n.undone ? "opacity-45" : ""} ${n.kind === "rewind" ? "border-info/50" : ""}`}>
+        <div className="flex items-start gap-3">
+          <div className="min-w-0 flex-1">
+            <div className="flex flex-wrap items-center gap-2">
+              <span className={`smcp rounded-[4px] border px-1.5 py-px text-[0.82rem] ${CHIP[n.kind]}`}>{n.label}</span>
+              {n.undone && <Chip tone="mute">undone by a later rewind</Chip>}
+              {n.snapshot !== null && !n.undone && (
+                <span className="text-[0.85rem] italic tabular-nums text-ink-2">snapshot {n.snapshot}{n.files !== null ? ` · ${n.files} file${n.files === 1 ? "" : "s"}` : ""}</span>
+              )}
+            </div>
+            <code className={`mt-1.5 block break-all font-mono text-[0.84rem] leading-relaxed ${n.kind === "rewind" ? "text-info" : "text-ink"} ${n.undone ? "line-through" : ""}`}>
+              {n.detail}
+            </code>
+            {n.sha && <div className="mt-1 text-[0.74rem] text-ink-3" title="SHA-256 of the snapshot's contents, as recorded in the ledger">sha256 <Hash h={n.sha} /></div>}
+          </div>
+          {n.snapshot !== null && n.active && canRewind && (
+            <Btn variant="info" size="sm" disabled={busy} onClick={() => onRewind(n.snapshot!)} className="shrink-0">
+              <span aria-hidden>↺</span> Rewind here
+            </Btn>
+          )}
+        </div>
+      </div>
+    </li>
+  );
+}
+
+export function TimelineView({ taskId, events, running }: { taskId: string | null; events: LedgerEvent[]; running: boolean }) {
+  const [busy, setBusy] = useState(false);
+  const [err, setErr] = useState<string | null>(null);
+  if (!taskId)
+    return <Empty title="No timeline yet">Run a task in the Workspace. Every step that changes the workspace gets a snapshot, and you can rewind to any of them while the task is running or held open.</Empty>;
+  const { nodes, holding, rewindPending } = timeline(events);
+  if (nodes.length === 0)
+    return <Empty title="No snapshots">{running ? "Waiting for the first snapshot…" : "This task has no snapshots: its sandbox could not take them, or it ran before snapshots existed."}</Empty>;
+
+  const act = async (fn: () => Promise<unknown>) => {
+    setBusy(true); setErr(null);
+    try { await fn(); } catch (e) { setErr((e as Error).message); } finally { setBusy(false); }
+  };
+  const canRewind = running && !rewindPending;
+  const rewinds = nodes.filter(n => n.kind === "rewind");
+  const note = "mb-4 rounded-[6px] border px-3.5 py-2.5 text-[0.92rem] leading-snug";
+  return (
+    <div className="min-h-0 flex-1 overflow-y-auto px-6 py-7">
+      <div className="mx-auto max-w-3xl">
+        <div className="mb-6">
+          <PageHead eyebrow="Time travel" title="Timeline"
+            sub={<><span className="font-mono not-italic">{taskId}</span> · <span className="tabular-nums">{nodes.filter(n => n.snapshot !== null && !n.undone).length} snapshots · {rewinds.length} rewind{rewinds.length === 1 ? "" : "s"}</span></>}
+            right={holding && (
+              <Btn variant="warn" disabled={busy} onClick={() => act(() => releaseTask(taskId))}>Release sandbox</Btn>
+            )} />
+        </div>
+        {holding && <p className={`${note} border-warn/50 bg-warn-wash text-ink`}>
+          The agent has stopped and its sandbox is being held open. Rewind to an earlier snapshot, or release it to finish the task.</p>}
+        {rewindPending && <p className={`${note} border-info/50 bg-info-wash text-ink`}>Rewind in progress: a fresh sandbox is being restored from the snapshot…</p>}
+        {!running && <p className="mb-4 text-[0.92rem] italic leading-snug text-ink-2">The task has ended and its sandbox is gone. The record below is read from the ledger; rewinding is only possible while a sandbox exists (start a task with “hold” to keep it open).</p>}
+        {err && <p role="alert" className={`${note} border-bad/50 bg-bad-wash text-bad`}>{err}</p>}
+        <ol className="relative ml-2 before:absolute before:bottom-2 before:left-[8px] before:top-3 before:w-px before:bg-gradient-to-b before:from-accent before:to-rule">
+          {nodes.map((n, i) => (
+            <Node key={n.key} n={n} i={i} canRewind={canRewind} busy={busy}
+              onRewind={id => act(() => rewindTask(taskId, id))} />
+          ))}
+        </ol>
+        <p className="mt-2 border-t border-rule pt-2.5 text-[0.84rem] italic leading-snug text-ink-3"><span className="mr-1 not-italic">†</span>A rewind replaces the sandbox: the new one starts from the snapshot's files only, so whatever the agent did to processes, /tmp or the environment is gone too. The ledger keeps everything, including what was undone.</p>
+      </div>
+    </div>
+  );
+}
